<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions: network + foreground service + notifications,
         plus Phase 4 survival (boot resurrection, data-sync foreground
         service type, exact-alarm scheduling). No dangerous permission is
         requested in this skeleton. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Phase 4: lets the "Request exemption" button open the one-tap
         battery-optimisation dialog; without it Android rejects the intent
         and the button falls back to the manual list. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Voice input (C6): SpeechRecognizer needs RECORD_AUDIO; the runtime
         grant request flow is a separate integration follow-up. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- M3 (App Factory): native APK install needs this; without it the
         PackageInstaller session + FileProvider install both fail. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Computer-use open_app: on Android 11+ getLaunchIntentForPackage()
         returns null for apps this app cannot see. Declaring the launcher
         intent here makes every launchable app visible (no
         QUERY_ALL_PACKAGES needed). Without it open_app fails with
         "No launchable app" even for installed apps like WhatsApp. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Codex">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share-to-Codex target (Subsystem 8): ACTION_SEND / ACTION_SEND_MULTIPLE
             for text and images. Exported: other apps send shares to it. -->
        <activity
            android:name=".ui.ShareActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Phase 4 (virtual-space survival): foreground service.
             Enabled in v0.4.0. Not exported. -->
        <service
            android:name=".service.CodexAgentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Subsystem 8: Quick Settings tile. Exported: the system binds it;
             only the system can (BIND_QUICK_SETTINGS_TILE). Tap opens the
             translucent TileOverlayActivity. -->
        <service
            android:name=".service.CodexTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Subsystem 8: translucent overlay opened from the tile. Not exported. -->
        <activity
            android:name=".service.TileOverlayActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- M3 (App Factory): FileProvider serving filesDir/builds/ for the
             native APK installer (authority <package>.fileprovider must
             match ApkInstaller.fileProviderAuthority). Not exported. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- M3 (App Factory): install-status receiver for the
             PackageInstaller session API. Not exported: only the
             system's PackageInstaller sends to it. -->
        <receiver
            android:name=".ci.ApkInstallStatusReceiver"
            android:exported="false" />

        <!-- Step 3 (v0.8.0): notification Approve/Deny receiver for
             AgentRuntime approvals. Not exported: only the app's own
             PendingIntents (from AgentRuntime's approval notification)
             send to it. -->
        <receiver
            android:name=".agent.ApprovalActionReceiver"
            android:exported="false" />

        <!-- Phase 4: boot receiver for resurrection after reboot.
             Enabled in v0.4.0. Exported: the system sends BOOT_COMPLETED. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Phase 4: alarm receiver for scheduled tasks. Not exported:
             only the app's own AlarmManager sends to it (explicit intent). -->
        <receiver
            android:name=".scheduler.TaskReceiver"
            android:exported="false" />

        <!-- Phase 2 (Android control): AccessibilityService.
             Enabled in v0.3.0. Not exported.
             Config lives in res/xml/accessibility_service_config.xml. -->
        <service
            android:name=".service.CodexAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
